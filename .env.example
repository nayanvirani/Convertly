SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
# No merchant-granted scopes are required right now — see the comment in
# shopify.app.toml's [access_scopes]. Add scopes here (and in that file)
# only when a feature actually needs to read/write shop resources.
SCOPES=""
PORT=3000

# Postgres connection string (e.g. the one Railway's Postgres plugin provides).
# Required — sessions, plan state, and analytics all live in this database.
DATABASE_URL=""

# The admin dashboard (installs/plan/token overview) is always reachable at
# the standard /admin path with a normal login screen. Optionally set this
# to ALSO expose it at a second, secret URL prefix — same accounts,
# independent session. Leave unset if you only want /admin.
ADMIN_PATH=""
# Each admin logs in with their own username/password, stored in the
# admin_users table — not set via env var. Create the first account with:
#   npm run admin:create-user -- <username> <password>
# (run more admins from the panel itself once you're logged in)
