{%- comment -%}
  Single app embed for all Convertly widgets. There are no per-widget Liquid
  settings here on purpose — every widget's config lives in the Convertly
  admin dashboard (Postgres, via /api/widgets-config) and is rendered
  client-side by convertly.js. Enable this once in the theme editor's App
  embeds panel and every widget you turn on in the Convertly dashboard shows
  up automatically, with no further theme-editor steps.
{%- endcomment -%}

{{ 'cb-core.css' | asset_url | stylesheet_tag }}

<div
  data-convertly-config
  hidden
  data-shop="{{ shop.permanent_domain }}"
  data-api="{{ app.metafields.convertly.api_base }}"
></div>
<script src="{{ 'convertly.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Convertly",
  "target": "body"
}
{% endschema %}
