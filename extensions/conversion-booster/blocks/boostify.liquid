{%- comment -%}
  Single app embed for all Boostify widgets. There are no per-widget Liquid
  settings here on purpose — every widget's config lives in the Boostify
  admin dashboard (Postgres, via /api/widgets-config) and is rendered
  client-side by boostify.js. Enable this once in the theme editor's App
  embeds panel and every widget you turn on in the Boostify dashboard shows
  up automatically, with no further theme-editor steps.
{%- endcomment -%}

{{ 'cb-core.css' | asset_url | stylesheet_tag }}

<div
  id="boostify-config"
  hidden
  data-shop="{{ shop.permanent_domain }}"
  data-api="{{ app.metafields.boostify.api_base }}"
></div>
<script src="{{ 'boostify.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Boostify",
  "target": "body"
}
{% endschema %}
